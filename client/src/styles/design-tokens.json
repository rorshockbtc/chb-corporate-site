  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "full": "9999px"
  },
  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky": 30,
    "header": 40,
    "modal": 50,
    "toast": 60
  },
  "elevation": {
    "editorial": "none",
    "commercialLight": "4px 4px 0px #111827",
    "commercialDark": "4px 4px 0px #EE8AB4"
  },
  "typography": {
    "minimumFloorPx": 13,
    "scales": {
      "display": { "family": "Fraunces, Georgia, serif", "weight": "600", "tracking": "-0.025em", "lineHeight": "1.06" },
      "heading": { "family": "Fraunces, Georgia, serif", "weight": "600", "tracking": "-0.015em", "lineHeight": "1.18" },
      "subheading": { "family": "Inter, system-ui, sans-serif", "weight": "600", "tracking": "0.12em" },
      "body": { "family": "Inter, system-ui, sans-serif", "weight": "400", "lineHeight": "1.65" },
      "editorialProse": { "family": "Fraunces, Georgia, serif", "weight": "400", "lineHeight": "1.75" },
      "metadata": { "family": "JetBrains Mono, ui-monospace, monospace", "weight": "600", "tracking": "0.08em" }
    }
  }
